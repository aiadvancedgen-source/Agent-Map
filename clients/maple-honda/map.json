          "icon": "message-circle",
          "status": "shipped",
          "workflow": [
            {
              "title": "A lead texts in",
              "when": "Inbound",
              "tool": "twilio",
              "body": [
                {
                  "type": "text",
                  "text": "The conversation starts by SMS."
                }
              ]
            },
            {
              "title": "Diana qualifies",
              "tool": "claude",
              "body": [
                {
                  "type": "text",
                  "text": "She asks what the buyer needs and answers from real inventory."
                }
              ]
            },
            {
              "title": "Hands over a qualified lead",
              "when": "Salesperson decides",
              "tone": "good",
              "body": [
                {
                  "type": "text",
                  "text": "The salesperson picks up a conversation that is already warm."
                }
              ]
            }
          ]
        },
        {
          "id": "buyer-auto-responder",
          "name": "Buyer Auto-Responder",
