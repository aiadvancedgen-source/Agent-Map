    },
    {
      "id": "inventory",
      "name": "Inventory",
      "color": "gold",
      "tools": [
        "nexcar-ca",
        "local-server"
      ],
      "agents": [
        {
          "id": "inventory-sync",
          "name": "Inventory Sync",
          "role": "Pulls every unit daily",
          "icon": "refresh-cw",
          "workflow": [
            {
              "title": "Starts every morning",
              "when": "7:00 AM daily",
              "tool": "local-server",
              "body": [
                {
                  "type": "text",
                  "text": "A scheduled task on the local server starts the sync. \"Run now\" does the same on demand."
                }
              ]
            },
            {
              "title": "Reads every car on nexcar.ca",
              "tool": "nexcar-ca",
              "body": [
                {
                  "type": "rows",
                  "rows": [
                    {
                      "label": "Specs and equipment",
                      "chip": {
                        "text": "Pulled",
                        "tone": "good"
                      }
                    },
                    {
                      "label": "Photos",
                      "chip": {
                        "text": "Pulled",
                        "tone": "good"
                      }
                    },
                    {
                      "label": "Carfax link",
                      "chip": {
                        "text": "Pulled",
                        "tone": "good"
                      }
                    }
                  ]
                }
              ]
            },
            {
              "title": "Saves a full record per unit",
              "tool": "local-server",
              "body": [
                {
                  "type": "text",
                  "text": "The lot is stored on the local server for every other agent to use."
                }
              ]
            },
            {
              "title": "Warns if the data goes stale",
              "when": "After 26 h",
              "tone": "problem",
              "body": [
                {
                  "type": "text",
                  "text": "The dashboard warns when the last sync is more than 26 hours old."
                },
                {
                  "type": "chips",
                  "chips": [
                    {
                      "text": "Stale sync",
                      "tone": "problem"
                    }
                  ]
                }
              ]
            }
          ],
          "status": "live"
        },
        {
          "id": "inventory-watch",
          "name": "Inventory Watch",
          "role": "Flags new, changed and removed cars",
          "icon": "scan-eye",
          "workflow": [
            {
              "title": "Compares the lot with the last pull",
              "when": "After each sync",
              "tool": "local-server"
            },
            {
              "title": "Flags what changed",
              "body": [
                {
                  "type": "rows",
                  "rows": [
                    {
                      "label": "Car added",
                      "chip": {
                        "text": "New listing",
                        "tone": "good"
                      }
                    },
                    {
                      "label": "Price changed",
                      "chip": {
                        "text": "Price change",
                        "tone": "accent"
                      }
                    },
                    {
                      "label": "Car removed",
                      "chip": {
                        "text": "Delisted"
                      }
                    }
                  ]
                }
              ]
            },
            {
              "title": "Keeps a rolling history",
              "when": "30 days",
              "body": [
                {
                  "type": "text",
                  "text": "Lot changes stay visible for 30 days. Delisted cars are hidden from the lot."
                }
              ]
            }
          ],
          "status": "live"
        },
        {
          "id": "sold-car-alert",
          "name": "Sold-car Alert",
          "role": "Warns when a sold car is still advertised",
          "icon": "siren",
          "workflow": [
            {
              "title": "You set a car's status",
              "when": "On change",
              "body": [
                {
                  "type": "chips",
                  "chips": [
                    {
                      "text": "Available"
                    },
                    {
                      "text": "Financing"
                    },
                    {
                      "text": "Body shop"
                    },
                    {
                      "text": "Sold",
                      "tone": "accent"
                    }
                  ]
                }
              ]
            },
            {
              "title": "Checks nexcar.ca for sold cars",
              "tool": "nexcar-ca",
              "body": [
                {
                  "type": "text",
                  "text": "Looks for each sold car in the latest pull from the site."
                }
              ]
            },
            {
              "title": "Raises the alert",
              "tone": "problem",
              "body": [
                {
                  "type": "chips",
                  "chips": [
                    {
                      "text": "Still advertised online",
                      "tone": "problem"
                    }
                  ]
                },
                {
                  "type": "text",
                  "text": "Shown in red on the dashboard while the car is still on the site."
                }
              ]
            }
          ],
          "status": "live"
        }
      ]
    }
  ],
  "flows": [
    {
      "from": "lead-triage",
      "to": "speed-to-lead",
      "label": "New leads"
    },
    {
      "from": "lead-triage",
