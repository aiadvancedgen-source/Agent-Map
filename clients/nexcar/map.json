    "logo": "nexcar-logo.png"
  },
  "hub": {
    "title": "Nexcar Sales OS",
    "kicker": "AI Advanced Gen · Agent map"
  },
  "approver": "Humza",
  "tools": {
    "d2c-media": {
      "name": "D2C Media",
      "logo": "d2c-media"
    },
    "claude": {
      "name": "Claude",
      "logo": "claude"
    },
    "facebook-marketplace": {
      "name": "Facebook Marketplace",
      "logo": "facebook-marketplace"
    },
    "chrome-extension": {
      "name": "Chrome extension",
      "logo": "chrome-extension"
    },
    "messenger": {
      "name": "Messenger",
      "logo": "messenger"
    },
    "nexcar-ca": {
      "name": "nexcar.ca",
      "logo": "client"
    },
    "local-server": {
      "name": "Local server",
      "icon": "server"
    }
  },
  "departments": [
    {
      "id": "lead-follow-up",
      "name": "Lead follow-up",
      "color": "orange",
      "tools": [
        "d2c-media",
        "claude"
      ],
      "agents": [
        {
          "id": "lead-triage",
          "name": "Lead Triage",
          "role": "Sorts every lead by history and timing",
          "icon": "list-filter",
          "workflow": [
            {
              "title": "Pulls the working leads",
              "when": "Every 10 min",
              "tool": "d2c-media",
              "body": [
                {
                  "type": "text",
                  "text": "Reads the open leads from D2C Media, with their tasks, notes, texts and emails."
                },
                {
                  "type": "chips",
                  "chips": [
                    {
                      "text": "To contact"
                    },
                    {
                      "text": "Follow-up manually"
                    }
                  ]
                }
              ]
            },
            {
              "title": "Reads each lead's history",
              "body": [
                {
                  "type": "text",
                  "text": "The customer's own message, everything sent so far, and when the last contact was."
                }
              ]
            },
            {
              "title": "Sorts each lead into a situation",
              "body": [
                {
                  "type": "rows",
                  "rows": [
                    {
                      "label": "Customer texted, waiting on a reply",
                      "chip": {
                        "text": "Reply first",
                        "tone": "problem"
                      }
                    },
                    {
                      "label": "New lead, no reply yet",
                      "chip": {
                        "text": "Speed-to-Lead",
                        "tone": "accent"
                      }
                    },
                    {
                      "label": "Contacted, follow-up due",
                      "chip": {
                        "text": "Follow-Up",
                        "tone": "accent"
                      }
                    },
                    {
                      "label": "Quiet for 14+ days",
                      "chip": {
                        "text": "Re-Engage",
                        "tone": "accent"
                      }
                    }
                  ]
                }
              ]
            },
            {
              "title": "Notes what they asked about",
              "body": [
                {
                  "type": "chips",
                  "chips": [
                    {
                      "text": "Availability"
                    },
                    {
                      "text": "Price"
                    },
                    {
                      "text": "Financing"
                    },
                    {
                      "text": "Trade-in"
                    },
                    {
                      "text": "Visit"
                    },
                    {
                      "text": "History"
                    },
                    {
                      "text": "Photos"
                    },
                    {
                      "text": "Warranty"
                    },
                    {
                      "text": "Delivery"
                    }
                  ]
                }
              ]
            }
          ],
          "status": "live"
        },
        {
          "id": "speed-to-lead",
          "name": "Speed-to-Lead",
          "role": "First reply to every new lead",
          "icon": "zap",
          "workflow": [
            {
              "title": "A new lead lands",
              "when": "New lead",
              "tool": "d2c-media",
              "body": [
                {
                  "type": "text",
                  "text": "Picked up from D2C Media on the next sync."
                }
              ]
            },
            {
              "title": "Matches the car on the live lot",
              "body": [
                {
                  "type": "text",
                  "text": "By stock number, or by year, make and model. If the car has sold, the reply offers the closest cars in stock instead."
                }
              ]
            },
            {
              "title": "Drafts the first reply",
              "tool": "claude",
              "body": [
                {
                  "type": "message",
                  "from": "Humza",
                  "to": "the lead",
                  "text": "Hi [first name], Humza here from Nexcar. Thanks for asking about the [year make model]. [Answers what they asked.] When works for you to come see it?"
                },
                {
                  "type": "chips",
                  "chips": [
                    {
                      "text": "Drafted with Claude",
                      "tone": "accent"
                    },
                    {
                      "text": "Template if Claude is unavailable"
                    }
                  ]
                }
              ]
            },
            {
              "title": "Humza approves and sends",
              "when": "You decide",
              "tool": "d2c-media",
              "tone": "good",
              "body": [
                {
                  "type": "decision",
                  "options": [
                    "Send text",
                    "Send email"
                  ]
                },
                {
                  "type": "text",
                  "text": "Every message goes out through D2C Media, so the CRM keeps the full record."
                }
              ]
            }
          ],
          "status": "building"
        },
        {
          "id": "follow-up",
          "name": "Follow-Up",
          "role": "Chases on day 1, 3, 7, 14, then monthly",
          "icon": "repeat",
          "workflow": [
            {
              "title": "Checks which follow-ups are due",
              "when": "Daily",
              "tool": "d2c-media",
              "body": [
                {
                  "type": "text",
                  "text": "Works out the day's due follow-ups from each lead's last contact."
                }
              ]
            },
            {
              "title": "First chase",
              "when": "Day 1",
              "tool": "claude",
              "body": [
                {
                  "type": "message",
                  "from": "Humza",
                  "to": "the lead",
                  "text": "Hi [first name], Humza from Nexcar. Just following up on the [year make model]. [Picks up from the last conversation.]"
                }
              ]
            },
            {
              "title": "Second chase",
              "when": "Day 3",
              "tool": "claude",
              "body": [
                {
                  "type": "text",
                  "text": "A new draft each time, written from the full history: their message, the car, your notes."
                }
              ]
            },
            {
              "title": "Third chase",
              "when": "Day 7",
              "tool": "claude"
            },
            {
              "title": "Fourth chase",
              "when": "Day 14",
              "tool": "claude"
            },
            {
              "title": "Keeps in touch",
              "when": "Then monthly",
              "tool": "claude",
              "body": [
                {
                  "type": "text",
                  "text": "After day 14 the lead moves to one follow-up a month."
                }
              ]
            },
            {
              "title": "Humza approves and sends",
              "when": "You decide",
              "tool": "d2c-media",
              "tone": "good",
              "body": [
                {
                  "type": "decision",
                  "options": [
                    "Send text",
                    "Send email"
                  ]
                },
                {
                  "type": "text",
                  "text": "Nothing is sent without approval."
                }
              ]
            }
          ],
          "status": "building"
        },
        {
          "id": "re-engage",
          "name": "Re-Engage",
          "role": "Wakes up leads quiet 14+ days",
          "icon": "alarm-clock",
          "workflow": [
            {
              "title": "Finds leads that have gone quiet",
              "when": "14+ days quiet",
              "tool": "d2c-media",
              "body": [
                {
                  "type": "text",
                  "text": "Leads with no contact for 14 days or more."
                }
              ]
            },
            {
              "title": "Checks the car is still on the lot",
              "body": [
                {
                  "type": "text",
                  "text": "If it has sold, the message offers the closest cars in stock instead."
                }
              ]
            },
            {
              "title": "Drafts a fresh opener",
              "tool": "claude",
              "body": [
                {
                  "type": "message",
                  "from": "Humza",
                  "to": "the lead",
                  "text": "Hi [first name], Humza from Nexcar. Are you still looking for a [make model]? [Shares what is on the lot now.]"
                }
              ]
            },
            {
              "title": "Humza approves and sends",
              "when": "You decide",
              "tool": "d2c-media",
              "tone": "good",
              "body": [
                {
                  "type": "decision",
                  "options": [
                    "Send text",
                    "Send email"
                  ]
                }
              ]
            }
          ],
          "status": "building"
        }
      ]
    },
    {
      "id": "marketplace",
      "name": "Marketplace",
      "color": "blue",
      "agents": [
        {
          "id": "marketplace-poster",
          "name": "Marketplace Poster",
          "role": "Lists each car on Facebook",
          "icon": "send",
          "tools": [
            "facebook-marketplace",
            "chrome-extension"
          ],
          "workflow": [
            {
              "title": "You pick a car",
              "when": "On click",
              "body": [
                {
                  "type": "text",
                  "text": "Press \"Post to FB Marketplace\" on any car in the dashboard."
                }
              ]
            },
            {
              "title": "Opens the Marketplace vehicle form",
              "tool": "chrome-extension",
              "body": [
                {
                  "type": "text",
                  "text": "A new Facebook tab opens on the create-vehicle page."
                }
              ]
            },
            {
              "title": "Fills the whole form",
              "tool": "facebook-marketplace",
              "body": [
                {
                  "type": "rows",
                  "rows": [
                    {
                      "label": "Title, price, description",
                      "chip": {
                        "text": "Filled",
                        "tone": "good"
                      }
                    },
                    {
                      "label": "Vehicle details",
                      "detail": "Year, make, model, mileage, condition, body style, transmission, fuel, colours",
                      "chip": {
                        "text": "Filled",
                        "tone": "good"
                      }
                    },
                    {
                      "label": "Photos",
                      "detail": "From the nexcar.ca listing, up to 20",
                      "chip": {
                        "text": "Added",
                        "tone": "good"
                      }
                    }
                  ]
                }
              ]
            },
            {
              "title": "Flags anything it could not set",
              "tone": "problem",
              "body": [
                {
                  "type": "chips",
                  "chips": [
                    {
                      "text": "Set by hand",
                      "tone": "problem"
                    }
                  ]
                },
                {
                  "type": "text",
                  "text": "Any field it could not fill is marked, so you can set it yourself."
                }
              ]
            },
            {
              "title": "You press Publish",
              "when": "You decide",
              "tool": "facebook-marketplace",
              "tone": "good",
              "body": [
                {
                  "type": "decision",
                  "options": [
                    "Publish on Facebook"
                  ]
                },
                {
                  "type": "text",
                  "text": "Nothing is published until you press Facebook's own Publish button."
                }
              ]
            },
            {
              "title": "Reports the live listing back",
              "tone": "good",
              "body": [
                {
                  "type": "text",
                  "text": "The dashboard records that the car is live, with its listing link."
                },
                {
                  "type": "chips",
                  "chips": [
                    {
                      "text": "Live on Marketplace",
                      "tone": "good"
                    }
                  ]
                }
              ]
            }
          ],
          "status": "live"
        },
        {
          "id": "marketplace-inbox",
          "name": "Marketplace Inbox",
          "role": "Drafts replies to buyers",
          "icon": "message-circle",
          "tools": [
            "messenger",
            "claude"
          ],
          "workflow": [
            {
              "title": "Reads your Marketplace conversations",
              "tool": "messenger",
              "body": [
                {
                  "type": "text",
                  "text": "Buyer, car, last message and unread state go to the dashboard's Inbox."
                }
              ]
            },
            {
              "title": "Matches the car",
              "body": [
                {
                  "type": "text",
                  "text": "By the Facebook listing it was posted as, or by year, make and model."
                },
                {
                  "type": "chips",
                  "chips": [
                    {
                      "text": "Sold cars flagged red",
                      "tone": "problem"
                    }
                  ]
                }
              ]
            },
            {
              "title": "Works out what the buyer is asking",
              "body": [
                {
                  "type": "chips",
                  "chips": [
                    {
                      "text": "Available?"
                    },
                    {
                      "text": "Price"
                    },
                    {
                      "text": "Book a visit"
                    },
                    {
                      "text": "Financing"
                    },
                    {
                      "text": "Where and hours"
                    },
                    {
                      "text": "Carfax"
                    },
                    {
                      "text": "Trade-in"
                    }
                  ]
                }
              ]
            },
            {
              "title": "Drafts the reply",
              "tool": "claude",
              "body": [
                {
                  "type": "chat",
                  "messages": [
                    {
                      "side": "them",
                      "text": "Is this still available?"
                    },
                    {
                      "side": "agent",
                      "text": "Hi [first name], Humza here from Nexcar. Yes, the [year make model] is available. When would you like to come see it?"
                    }
                  ]
                },
                {
                  "type": "text",
                  "text": "Drafts use real inventory data. If the car has sold, the reply offers similar cars instead."
                }
              ]
            },
            {
              "title": "You press Send",
              "when": "You decide",
              "tool": "messenger",
              "tone": "good",
              "body": [
                {
                  "type": "decision",
                  "options": [
                    "Insert reply"
                  ]
                },
                {
                  "type": "text",
                  "text": "Insert reply puts the text in the message box. Nothing is sent automatically."
                }
              ]
            }
          ],
          "status": "live"
        },
        {
          "id": "listing-sync",
          "name": "Listing Sync",
          "role": "Builds the take-down list for sold cars",
          "icon": "list-checks",
          "tools": [
            "facebook-marketplace",
            "nexcar-ca"
          ],
          "workflow": [
            {
              "title": "Reads your Facebook listings",
              "tool": "facebook-marketplace",
              "body": [
                {
                  "type": "text",
                  "text": "From the \"Your listings\" page."
                }
              ]
            },
            {
              "title": "Matches each listing to a car",
              "tool": "nexcar-ca",
              "body": [
                {
                  "type": "text",
                  "text": "Every listing is paired with a car from the inventory."
                }
              ]
            },
            {
              "title": "Builds two lists",
              "body": [
                {
                  "type": "rows",
                  "rows": [
                    {
                      "label": "Post queue",
                      "detail": "Cars not yet on Marketplace",
                      "chip": {
                        "text": "To post",
                        "tone": "accent"
                      }
                    },
                    {
                      "label": "Take-down list",
                      "detail": "Sold or gone cars still listed",
                      "chip": {
                        "text": "Take down",
                        "tone": "problem"
                      }
                    }
                  ]
                },
                {
                  "type": "text",
                  "text": "Both lists show on the dashboard's Home screen."
                }
              ]
            }
          ],
          "status": "building"
        }
      ]
    },
    {
      "id": "marketing",
      "name": "Marketing",
      "color": "purple",
      "tools": [
        "nexcar-ca"
      ],
      "agents": [
        {
          "id": "marketplace-copy",
          "name": "Marketplace copy",
